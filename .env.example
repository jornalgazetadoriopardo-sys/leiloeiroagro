# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Painel do Supabase → Project Settings → API).
# Sem estas variáveis o app abre em modo demonstração.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Subdomínio do tenant ativo (Fase 1 tem uma única leiloeira).
NEXT_PUBLIC_TENANT_SUBDOMINIO=piloto
